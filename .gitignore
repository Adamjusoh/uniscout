# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
*.pem
*.key
credentials.json

# IDEs & Text Editors
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Node.js / JavaScript (Frontend / Backend)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.next/
out/
build/
dist/

# PHP / Composer
# ------------------------------------------------------------------------------
vendor/
composer.phar
.phpunit.result.cache

# Python / Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/

# Logs & Databases
# ------------------------------------------------------------------------------
logs/
*.log
*.sqlite
*.sqlite3
*.db

# Temporary & Cache Files
# ------------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
